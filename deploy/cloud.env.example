# Configure values in the host's secret/environment interface, never in Git.
NOAH_CLOUD_ORIGIN=https://compute.zenithsmart.xin
NOAH_PROFILE=research-v1
NOAH_DATA=/var/data/noah
# Use ephemeral-test only for a free connectivity test; all POSTs are disabled.
NOAH_STORAGE_MODE=ephemeral-test
NOAH_OWNER_USER=owner
# Generate two DISTINCT random secrets with >=32 characters. No real secrets here.
NOAH_OWNER_PASSWORD=CHANGE_ME_TO_A_DISTINCT_RANDOM_OWNER_SECRET
NOAH_JOIN_TOKEN=CHANGE_ME_TO_A_DIFFERENT_RANDOM_INVITATION
